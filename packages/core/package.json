{
  "name": "@stateledger/core",
  "version": "1.0.0",
  "description": "Database-backed state machine for Node and TypeScript \u2014 core (ORM-agnostic).",
  "license": "MIT",
  "author": {
    "name": "Enow Divine",
    "email": "sirdivine16@gmail.com",
    "url": "https://github.com/enowdivine"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/enowdivine/stateledger.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/enowdivine/stateledger#readme",
  "bugs": {
    "url": "https://github.com/enowdivine/stateledger/issues"
  },
  "keywords": [
    "state-machine",
    "fsm",
    "audit-trail",
    "transitions",
    "postgres",
    "typescript",
    "stateledger"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./contract-tests": {
      "import": {
        "types": "./dist/contract-tests.d.ts",
        "default": "./dist/contract-tests.js"
      },
      "require": {
        "types": "./dist/contract-tests.d.cts",
        "default": "./dist/contract-tests.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vitest": ">=1"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@stateledger/memory": "workspace:*",
    "vitest": "^2.1.8"
  }
}
